rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role in ['administrador', 'desarrollador'];
    }

    match /catalog_store/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /catalog_categories/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /catalog_products/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /catalog_orders/{id} {
      allow create: if signedIn();
      allow read: if isStaff()
        || (signedIn() && resource.data.customerEmail == request.auth.token.email);
      allow update, delete: if isStaff();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isStaff());
      allow delete: if isStaff();
    }
  }
}
